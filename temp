<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>India & World Geography Map</title>

  <!-- D3 -->
  <script src="https://cdn.jsdelivr.net/npm/d3@7"></script>

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      width: 100%;
      min-height: 100%;
      font-family: Arial, Helvetica, sans-serif;
      background: #f5f7fb;
      color: #172033;
    }

    body {
      overflow-x: hidden;
    }

    .app {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    header {
      background: #ffffff;
      border-bottom: 1px solid #dfe4ec;
      padding: 14px 20px;
      position: sticky;
      top: 0;
      z-index: 20;
    }

    .header-row {
      max-width: 1400px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }

    .title-area {
      min-width: 0;
    }

    .title-area h1 {
      margin: 0;
      font-size: 24px;
      line-height: 1.2;
      font-weight: 700;
    }

    .title-area p {
      margin: 4px 0 0;
      color: #657084;
      font-size: 14px;
    }

    .controls {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    button {
      border: 1px solid #cbd3df;
      background: #ffffff;
      color: #172033;
      border-radius: 8px;
      padding: 9px 14px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: 0.15s ease;
    }

    button:hover {
      background: #eef3fa;
      border-color: #aeb9ca;
    }

    .back {
      display: none;
    }

    .world-btn {
      display: none;
    }

    main {
      flex: 1;
      width: 100%;
      max-width: 1500px;
      margin: 0 auto;
      padding: 18px;
    }

    .map-card {
      position: relative;
      background: #ffffff;
      border: 1px solid #dfe4ec;
      border-radius: 12px;
      min-height: calc(100vh - 115px);
      overflow: hidden;
    }

    #map-container {
      width: 100%;
      height: calc(100vh - 115px);
      min-height: 520px;
      position: relative;
    }

    svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    .region {
      stroke: #ffffff;
      stroke-width: 0.8;
      vector-effect: non-scaling-stroke;
      cursor: pointer;
      transition:
        fill 0.12s ease,
        stroke 0.12s ease,
        opacity 0.12s ease;
    }

    .region:hover {
      stroke: #172033;
      stroke-width: 1.5;
      opacity: 0.88;
    }

    .india-region {
      cursor: pointer;
    }

    .district-region,
    .country-region,
    .adm1-region {
      cursor: default;
    }

    .country-region {
      cursor: pointer;
    }

    .loading {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.88);
      z-index: 10;
      font-size: 16px;
      color: #536074;
    }

    .loading.hidden {
      display: none;
    }

    .error-box {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: min(520px, calc(100% - 40px));
      background: #ffffff;
      border: 1px solid #e0e5ed;
      border-radius: 12px;
      padding: 22px;
      text-align: center;
      box-shadow: 0 10px 30px rgba(20, 30, 50, 0.08);
      z-index: 12;
    }

    .error-box h3 {
      margin: 0 0 8px;
      font-size: 18px;
    }

    .error-box p {
      margin: 0 0 15px;
      color: #657084;
      line-height: 1.5;
      font-size: 14px;
    }

    .error-box button {
      background: #172033;
      color: white;
      border-color: #172033;
    }

    .error-box button:hover {
      background: #293650;
    }

    .tooltip {
      position: fixed;
      pointer-events: none;
      display: none;
      z-index: 100;
      background: #172033;
      color: white;
      padding: 7px 10px;
      border-radius: 6px;
      font-size: 13px;
      line-height: 1.2;
      white-space: nowrap;
      box-shadow: 0 5px 18px rgba(0, 0, 0, 0.16);
    }

    .status {
      position: absolute;
      bottom: 12px;
      left: 12px;
      z-index: 8;
      background: rgba(255, 255, 255, 0.92);
      border: 1px solid #dfe4ec;
      border-radius: 7px;
      padding: 7px 10px;
      color: #657084;
      font-size: 12px;
      display: none;
    }

    @media (max-width: 700px) {
      header {
        padding: 12px;
      }

      .header-row {
        align-items: flex-start;
      }

      .title-area h1 {
        font-size: 19px;
      }

      .title-area p {
        font-size: 12px;
      }

      button {
        padding: 8px 10px;
        font-size: 12px;
      }

      main {
        padding: 10px;
      }

      #map-container {
        height: calc(100vh - 100px);
        min-height: 450px;
      }

      .map-card {
        min-height: calc(100vh - 100px);
      }
    }
  </style>
</head>

<body>

<div class="app">

  <header>
    <div class="header-row">

      <div class="title-area">
        <h1 id="page-title">India</h1>
        <p id="page-subtitle">States & Union Territories</p>
      </div>

      <div class="controls">
        <button id="back-button" class="back">← Back</button>
        <button id="world-button" class="world-btn">World</button>
      </div>

    </div>
  </header>

  <main>
    <div class="map-card">

      <div id="map-container"></div>

      <div id="loading" class="loading">
        Loading map...
      </div>

      <div id="error-box" class="error-box" style="display:none;">
        <h3>Could not load the map.</h3>
        <p id="error-message">
          Please check your internet connection and try again.
        </p>
        <button id="retry-button">Retry</button>
      </div>

      <div id="status" class="status"></div>

    </div>
  </main>

</div>

<div id="tooltip" class="tooltip"></div>


<script>
/* =========================================================
   CONFIGURATION
========================================================= */

/*
 * INDIA MAP
 *
 * Source:
 * datta07/INDIAN-SHAPEFILES
 */

const INDIA_BASES = [
  "https://raw.githubusercontent.com/datta07/INDIAN-SHAPEFILES/master/INDIA/",
  "https://cdn.jsdelivr.net/gh/datta07/INDIAN-SHAPEFILES@master/INDIA/"
];

const STATE_BASES = [
  "https://raw.githubusercontent.com/datta07/INDIAN-SHAPEFILES/master/STATES/",
  "https://cdn.jsdelivr.net/gh/datta07/INDIAN-SHAPEFILES@master/STATES/"
];

const INDIA_FILE = "INDIA_STATES.geojson";


/*
 * WORLD COUNTRY MAP
 *
 * Natural Earth 1:110m country GeoJSON
 */
const WORLD_COUNTRIES_URL =
  "https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_110m_admin_0_countries.geojson";


/*
 * geoBoundaries API
 *
 * ADM1 = first-level administrative divisions.
 */
const GEOBOUNDARIES_API =
  "https://www.geoboundaries.org/api/current/gbOpen";


/* =========================================================
   INDIA STATE FOLDER MAPPING
========================================================= */

const STATE_FOLDER = {

  "Andaman and Nicobar Islands":
    "ANDAMAN AND NICOBAR ISLANDS",

  "Andhra Pradesh":
    "ANDHRA PRADESH",

  "Arunachal Pradesh":
    "ARUNACHAL PRADESH",

  "Assam":
    "ASSAM",

  "Bihar":
    "BIHAR",

  "Chandigarh":
    "CHANDIGARH",

  "Chhattisgarh":
    "CHHATTISGARH",

  "Dadra and Nagar Haveli and Daman and Diu":
    "DADRA AND NAGAR HAVELI AND DAMAN AND DIU",

  "Delhi":
    "DELHI",

  "Goa":
    "GOA",

  "Gujarat":
    "GUJARAT",

  "Haryana":
    "HARYANA",

  "Himachal Pradesh":
    "HIMACHAL PRADESH",

  "Jammu and Kashmir":
    "JAMMU AND KASHMIR",

  "Jharkhand":
    "JHARKHAND",

  "Karnataka":
    "KARNATAKA",

  "Kerala":
    "KERALA",

  "Ladakh":
    "LADAKH",

  "Lakshadweep":
    "LAKSHADWEEP",

  "Madhya Pradesh":
    "MADHYA PRADESH",

  "Maharashtra":
    "MAHARASHTRA",

  "Manipur":
    "MANIPUR",

  "Meghalaya":
    "MEGHALAYA",

  "Mizoram":
    "MIZORAM",

  "Nagaland":
    "NAGALAND",

  "Odisha":
    "ORISSA",

  "Puducherry":
    "PUDUCHERRY",

  "Punjab":
    "PUNJAB",

  "Rajasthan":
    "RAJASTHAN",

  "Sikkim":
    "SIKKIM",

  "Tamil Nadu":
    "TAMIL NADU",

  "Telangana":
    "TELANGANA",

  "Tripura":
    "TRIPURA",

  "Uttar Pradesh":
    "UTTAR PRADESH",

  "Uttarakhand":
    "UTTARAKHAND",

  "West Bengal":
    "WEST BENGAL"
};


/*
 * Some repositories use a filename that doesn't exactly
 * match the folder name.
 */
const STATE_FILE_NAME = {

  "Odisha":
    "ODISHA_DISTRICTS.geojson"

};


/* =========================================================
   STATE NAME NORMALIZATION
========================================================= */

const STATE_ALIASES = {

  "ORISSA": "Odisha",

  "ODISHA": "Odisha",

  "NCT OF DELHI": "Delhi",

  "DELHI": "Delhi",

  "PONDICHERRY": "Puducherry",

  "PUDUCHERRY": "Puducherry",

  "UTTARANCHAL": "Uttarakhand",

  "UTTARAKHAND": "Uttarakhand",

  "JAMMU & KASHMIR": "Jammu and Kashmir",

  "JAMMU AND KASHMIR": "Jammu and Kashmir",

  "DADRA AND NAGAR HAVELI": "Dadra and Nagar Haveli and Daman and Diu",

  "DAMAN AND DIU":
    "Dadra and Nagar Haveli and Daman and Diu",

  "DADRA & NAGAR HAVELI AND DAMAN & DIU":
    "Dadra and Nagar Haveli and Daman and Diu"

};


function normalizeText(value) {

  if (value === undefined || value === null) {
    return "";
  }

  return String(value)
    .trim()
    .replace(/\s+/g, " ")
    .toUpperCase();
}


function canonicalStateName(value) {

  const normalized = normalizeText(value);

  if (!normalized) {
    return "";
  }

  if (STATE_ALIASES[normalized]) {
    return STATE_ALIASES[normalized];
  }

  for (const stateName of Object.keys(STATE_FOLDER)) {

    if (normalizeText(stateName) === normalized) {
      return stateName;
    }

    if (normalizeText(STATE_FOLDER[stateName]) === normalized) {
      return stateName;
    }
  }

  return value;
}


/* =========================================================
   APPLICATION STATE
========================================================= */

let currentLevel = "india";

let currentState = null;

let currentCountry = null;

let lastRender = null;


/* =========================================================
   DOM
========================================================= */

const mapContainer =
  document.getElementById("map-container");

const tooltip =
  document.getElementById("tooltip");

const loading =
  document.getElementById("loading");

const errorBox =
  document.getElementById("error-box");

const errorMessage =
  document.getElementById("error-message");

const retryButton =
  document.getElementById("retry-button");

const backButton =
  document.getElementById("back-button");

const worldButton =
  document.getElementById("world-button");

const pageTitle =
  document.getElementById("page-title");

const pageSubtitle =
  document.getElementById("page-subtitle");

const statusBox =
  document.getElementById("status");


/* =========================================================
   UI HELPERS
========================================================= */

function showLoading(message = "Loading map...") {

  loading.textContent = message;
  loading.classList.remove("hidden");

}


function hideLoading() {

  loading.classList.add("hidden");

}


function showError(message) {

  hideLoading();

  errorMessage.textContent = message;

  errorBox.style.display = "block";

}


function hideError() {

  errorBox.style.display = "none";

}


function clearMap() {

  mapContainer.innerHTML = "";

}


function setStatus(message) {

  if (!message) {

    statusBox.style.display = "none";
    statusBox.textContent = "";

    return;
  }

  statusBox.textContent = message;
  statusBox.style.display = "block";
}


function hideStatus() {

  setStatus("");

}


function updateHeader() {

  if (currentLevel === "india") {

    pageTitle.textContent = "India";
    pageSubtitle.textContent =
      "States & Union Territories";

    backButton.style.display = "none";
    worldButton.style.display = "inline-block";

  }

  else if (currentLevel === "state") {

    pageTitle.textContent = currentState;
    pageSubtitle.textContent =
      "Districts";

    backButton.style.display = "inline-block";
    backButton.textContent = "← India";

    worldButton.style.display = "inline-block";

  }

  else if (currentLevel === "world") {

    pageTitle.textContent = "World";
    pageSubtitle.textContent =
      "Countries";

    backButton.style.display = "inline-block";
    backButton.textContent = "← India";

    worldButton.style.display = "none";

  }

  else if (currentLevel === "country") {

    pageTitle.textContent =
      currentCountry ? currentCountry.name : "Country";

    pageSubtitle.textContent =
      "States / Provinces / Regions";

    backButton.style.display = "inline-block";
    backButton.textContent = "← World";

    worldButton.style.display = "none";
  }
}


/* =========================================================
   TOOLTIP
========================================================= */

function showTooltip(event, text) {

  tooltip.textContent = text;

  tooltip.style.display = "block";

  moveTooltip(event);
}


function moveTooltip(event) {

  const padding = 14;

  let x = event.clientX + padding;
  let y = event.clientY + padding;

  const rect =
    tooltip.getBoundingClientRect();

  if (x + rect.width > window.innerWidth - 10) {
    x = event.clientX - rect.width - padding;
  }

  if (y + rect.height > window.innerHeight - 10) {
    y = event.clientY - rect.height - padding;
  }

  tooltip.style.left = `${x}px`;
  tooltip.style.top = `${y}px`;
}


function hideTooltip() {

  tooltip.style.display = "none";

}


/* =========================================================
   FETCH HELPER
========================================================= */

async function fetchJSON(urls) {

  const candidates =
    Array.isArray(urls) ? urls : [urls];

  let lastError = null;

  for (const url of candidates) {

    try {

      const response =
        await fetch(url, {
          cache: "no-cache"
        });

      if (!response.ok) {
        throw new Error(
          `HTTP ${response.status}`
        );
      }

      return await response.json();

    } catch (error) {

      lastError = error;

    }
  }

  throw lastError ||
    new Error("Unable to fetch data.");
}


/* =========================================================
   SVG / D3 HELPERS
========================================================= */

function createSVG() {

  const width =
    mapContainer.clientWidth || 1000;

  const height =
    mapContainer.clientHeight || 600;

  const svg =
    d3.select(mapContainer)
      .append("svg")
      .attr("viewBox", `0 0 ${width} ${height}`)
      .attr("preserveAspectRatio", "xMidYMid meet");

  return {
    svg,
    width,
    height
  };
}


function fitProjection(features, width, height) {

  const collection =
    features && features.type === "FeatureCollection"
      ? features
      : {
          type: "FeatureCollection",
          features: features || []
        };

  const projection =
    d3.geoMercator();

  projection.fitExtent(
    [
      [35, 25],
      [width - 35, height - 25]
    ],
    collection
  );

  return projection;
}


function getFeatureName(feature, fallback = "Unknown") {

  const p = feature && feature.properties
    ? feature.properties
    : {};

  const possibleKeys = [
    "name",
    "NAME",
    "Name",
    "NAME_0",
    "NAME_1",
    "NAME_2",
    "shapeName",
    "shapeName_1",
    "shapeName_2",
    "district",
    "DISTRICT",
    "District",
    "state",
    "STATE",
    "State",
    "VARNAME_1",
    "admin1Name",
    "ADM1_NAME",
    "province",
    "PROVINCE",
    "region",
    "REGION"
  ];

  for (const key of possibleKeys) {

    if (
      p[key] !== undefined &&
      p[key] !== null &&
      String(p[key]).trim() !== ""
    ) {

      return String(p[key]).trim();
    }
  }

  return fallback;
}


/* =========================================================
   COLORS
========================================================= */

function indiaColor(index) {

  const colors = [
    "#dbeafe",
    "#dcfce7",
    "#fef3c7",
    "#fce7f3",
    "#ede9fe",
    "#cffafe",
    "#ffedd5",
    "#e0e7ff"
  ];

  return colors[index % colors.length];
}


function worldColor(index) {

  const colors = [
    "#e0f2fe",
    "#dcfce7",
    "#fef3c7",
    "#fce7f3",
    "#ede9fe",
    "#cffafe",
    "#ffedd5",
    "#e2e8f0"
  ];

  return colors[index % colors.length];
}


/* =========================================================
   INDIA MAP
========================================================= */

async function loadIndiaMap() {

  currentLevel = "india";
  currentState = null;
  currentCountry = null;

  updateHeader();

  hideError();
  hideStatus();

  clearMap();

  showLoading("Loading India map...");

  try {

    const urls =
      INDIA_BASES.map(
        base => base + INDIA_FILE
      );

    const geojson =
      await fetchJSON(urls);

    renderIndiaMap(geojson);

    hideLoading();

  } catch (error) {

    console.error(error);

    showError(
      "India map could not be loaded. " +
      "Please check your internet connection and try again."
    );
  }
}


function renderIndiaMap(geojson) {

  clearMap();

  const {
    svg,
    width,
    height
  } = createSVG();

  const features =
    geojson.features || [];

  if (!features.length) {
    throw new Error("India GeoJSON contains no features.");
  }

  const projection =
    fitProjection(
      features,
      width,
      height
    );

  const path =
    d3.geoPath(projection);

  svg
    .append("g")
    .selectAll("path")
    .data(features)
    .join("path")
    .attr("class", "region india-region")
    .attr("d", path)
    .attr("fill", (_, i) => indiaColor(i))
    .on("mouseenter", function(event, feature) {

      const name =
        canonicalStateName(
          getFeatureName(feature)
        );

      showTooltip(event, name);

    })
    .on("mousemove", function(event) {

      moveTooltip(event);

    })
    .on("mouseleave", function() {

      hideTooltip();

    })
    .on("click", function(event, feature) {

      hideTooltip();

      const name =
        canonicalStateName(
          getFeatureName(feature)
        );

      if (!name) {
        return;
      }

      loadStateMap(name);

    });

  lastRender = () => renderIndiaMap(geojson);
}


/* =========================================================
   STATE DISTRICT MAP
========================================================= */

async function loadStateMap(stateName) {

  const canonical =
    canonicalStateName(stateName);

  if (!STATE_FOLDER[canonical]) {

    showError(
      `District data is not configured for "${stateName}".`
    );

    return;
  }

  currentLevel = "state";
  currentState = canonical;
  currentCountry = null;

  updateHeader();

  hideError();
  hideStatus();

  clearMap();

  showLoading(
    `Loading ${canonical} districts...`
  );

  try {

    const folder =
      STATE_FOLDER[canonical];

    const filename =
      STATE_FILE_NAME[canonical] ||
      `${folder}_DISTRICTS.geojson`;

    const urls =
      STATE_BASES.map(
        base =>
          base +
          encodeURIComponent(folder)
            .replace(/%20/g, "%20") +
          "/" +
          encodeURIComponent(filename)
            .replace(/%20/g, "%20")
      );

    const geojson =
      await fetchJSON(urls);

    renderDistrictMap(
      geojson,
      canonical
    );

    hideLoading();

  } catch (error) {

    console.error(
      "State district load failed:",
      canonical,
      error
    );

    showError(
      `Could not load district boundaries for ${canonical}.`
    );
  }
}


function renderDistrictMap(
  geojson,
  stateName
) {

  clearMap();

  const {
    svg,
    width,
    height
  } = createSVG();

  const features =
    geojson.features || [];

  if (!features.length) {
    throw new Error(
      "District GeoJSON contains no features."
    );
  }

  const projection =
    fitProjection(
      features,
      width,
      height
    );

  const path =
    d3.geoPath(projection);

  svg
    .append("g")
    .selectAll("path")
    .data(features)
    .join("path")
    .attr("class", "region district-region")
    .attr("d", path)
    .attr("fill", (_, i) => indiaColor(i))
    .on("mouseenter", function(event, feature) {

      const district =
        getFeatureName(
          feature,
          "District"
        );

      showTooltip(
        event,
        district
      );

    })
    .on("mousemove", function(event) {

      moveTooltip(event);

    })
    .on("mouseleave", function() {

      hideTooltip();

    });

  lastRender = () =>
    renderDistrictMap(
      geojson,
      stateName
    );
}


/* =========================================================
   WORLD COUNTRY MAP
========================================================= */

async function loadWorldMap() {

  currentLevel = "world";
  currentState = null;
  currentCountry = null;

  updateHeader();

  hideError();
  hideStatus();

  clearMap();

  showLoading("Loading world map...");

  try {

    const geojson =
      await fetchJSON(
        WORLD_COUNTRIES_URL
      );

    renderWorldMap(geojson);

    hideLoading();

  } catch (error) {

    console.error(error);

    showError(
      "World map could not be loaded. " +
      "Please check your internet connection and try again."
    );
  }
}


function getCountryISO(feature) {

  const p =
    feature && feature.properties
      ? feature.properties
      : {};

  const candidates = [
    p.ISO_A3,
    p.ADM0_A3,
    p.ISO_A3_EH,
    p.SOV_A3
  ];

  for (const value of candidates) {

    if (
      value &&
      value !== "-99" &&
      value !== "–"
    ) {

      return String(value).toUpperCase();
    }
  }

  return "";
}


function getCountryName(feature) {

  const p =
    feature && feature.properties
      ? feature.properties
      : {};

  const candidates = [
    p.NAME,
    p.NAME_LONG,
    p.ADMIN,
    p.SOVEREIGNT
  ];

  for (const value of candidates) {

    if (
      value !== undefined &&
      value !== null &&
      String(value).trim() !== ""
    ) {

      return String(value).trim();
    }
  }

  return "Unknown country";
}


function renderWorldMap(geojson) {

  clearMap();

  const {
    svg,
    width,
    height
  } = createSVG();

  const features =
    geojson.features || [];

  if (!features.length) {
    throw new Error(
      "World GeoJSON contains no features."
    );
  }

  const projection =
    d3.geoNaturalEarth1();

  projection.fitExtent(
    [
      [20, 20],
      [width - 20, height - 20]
    ],
    geojson
  );

  const path =
    d3.geoPath(projection);

  svg
    .append("g")
    .selectAll("path")
    .data(features)
    .join("path")
    .attr("class", "region country-region")
    .attr("d", path)
    .attr("fill", (_, i) => worldColor(i))
    .on("mouseenter", function(event, feature) {

      showTooltip(
        event,
        getCountryName(feature)
      );

    })
    .on("mousemove", function(event) {

      moveTooltip(event);

    })
    .on("mouseleave", function() {

      hideTooltip();

    })
    .on("click", function(event, feature) {

      hideTooltip();

      const name =
        getCountryName(feature);

      const iso =
        getCountryISO(feature);

      if (!iso || iso === "-99") {

        showError(
          `ADM1 data is not available automatically for ${name}.`
        );

        return;
      }

      loadCountryMap({
        name,
        iso
      });

    });

  lastRender =
    () => renderWorldMap(geojson);
}


/* =========================================================
   GEOBOUNDARIES URL FIX
========================================================= */

/*
 * geoBoundaries returns GitHub raw URLs such as:
 *
 * https://github.com/wmgeolab/geoBoundaries/raw/COMMIT/...
 *
 * Those URLs can redirect to GitHub's media server.
 *
 * We first try the direct URL, then a browser-friendly
 * GitHub content URL, then jsDelivr where possible.
 */

function convertGeoBoundariesURL(url) {

  if (!url) {
    return null;
  }

  let clean = String(url);

  /*
   * If the API gives:
   *
   * github.com/wmgeolab/geoBoundaries/raw/COMMIT/PATH
   *
   * convert to:
   *
   * raw.githubusercontent.com/wmgeolab/geoBoundaries/COMMIT/PATH
   */
  const githubRawMatch =
    clean.match(
      /^https?:\/\/github\.com\/wmgeolab\/geoBoundaries\/raw\/([^/]+)\/(.+)$/i
    );

  if (githubRawMatch) {

    const commit =
      githubRawMatch[1];

    const filePath =
      githubRawMatch[2];

    return {
      direct: clean,

      raw:
        `https://raw.githubusercontent.com/wmgeolab/geoBoundaries/${commit}/${filePath}`,

      jsdelivr:
        `https://cdn.jsdelivr.net/gh/wmgeolab/geoBoundaries@${commit}/${filePath}`
    };
  }

  return {
    direct: clean
  };
}


/* =========================================================
   COUNTRY ADM1
========================================================= */

async function loadCountryMap(country) {

  currentLevel = "country";

  currentCountry = country;

  currentState = null;

  updateHeader();

  hideError();
  hideStatus();

  clearMap();

  showLoading(
    `Loading ${country.name} regions...`
  );

  try {

    /*
     * geoBoundaries API returns a JSON object containing
     * metadata and the GeoJSON download URL.
     */
    const apiURL =
      `${GEOBOUNDARIES_API}/${country.iso}/ADM1/`;

    const metadata =
      await fetchJSON(apiURL);

    const geoURL =
      metadata.simplifiedGeometryGeoJSON ||
      metadata.gjDownloadURL;

    if (!geoURL) {

      throw new Error(
        "geoBoundaries did not return a GeoJSON URL."
      );
    }

    const candidates =
      buildCountryGeoJSONCandidates(
        geoURL
      );

    let geojson = null;

    let lastError = null;

    for (const url of candidates) {

      try {

        geojson =
          await fetchJSON(url);

        if (
          geojson &&
          Array.isArray(geojson.features)
        ) {

          break;
        }

      } catch (error) {

        lastError = error;
      }
    }

    if (
      !geojson ||
      !Array.isArray(geojson.features)
    ) {

      throw (
        lastError ||
        new Error(
          "Country ADM1 GeoJSON could not be downloaded."
        )
      );
    }

    renderCountryADM1(
      geojson,
      country
    );

    hideLoading();

  } catch (error) {

    console.error(
      "Country ADM1 load failed:",
      country,
      error
    );

    showError(
      `Could not load the administrative divisions for ${country.name}.`
    );
  }
}


function buildCountryGeoJSONCandidates(
  originalURL
) {

  const converted =
    convertGeoBoundariesURL(
      originalURL
    );

  const candidates = [];

  if (converted) {

    if (converted.raw) {
      candidates.push(
        converted.raw
      );
    }

    if (converted.jsdelivr) {
      candidates.push(
        converted.jsdelivr
      );
    }

    if (converted.direct) {
      candidates.push(
        converted.direct
      );
    }

  } else {

    candidates.push(
      originalURL
    );
  }

  /*
   * Remove duplicates.
   */
  return [
    ...new Set(candidates)
  ];
}


/* =========================================================
   COUNTRY ADM1 RENDER
========================================================= */

function renderCountryADM1(
  geojson,
  country
) {

  clearMap();

  const {
    svg,
    width,
    height
  } = createSVG();

  const features =
    geojson.features || [];

  if (!features.length) {

    throw new Error(
      "ADM1 GeoJSON contains no divisions."
    );
  }

  const projection =
    fitProjection(
      features,
      width,
      height
    );

  const path =
    d3.geoPath(projection);

  svg
    .append("g")
    .selectAll("path")
    .data(features)
    .join("path")
    .attr(
      "class",
      "region adm1-region"
    )
    .attr("d", path)
    .attr(
      "fill",
      (_, i) => worldColor(i)
    )
    .on("mouseenter", function(event, feature) {

      showTooltip(
        event,
        getADM1Name(feature)
      );

    })
    .on("mousemove", function(event) {

      moveTooltip(event);

    })
    .on("mouseleave", function() {

      hideTooltip();

    });

  lastRender =
    () =>
      renderCountryADM1(
        geojson,
        country
      );
}


function getADM1Name(feature) {

  const p =
    feature && feature.properties
      ? feature.properties
      : {};

  /*
   * geoBoundaries normally exposes shapeName.
   * Several fallbacks are included because different
   * country source datasets use different property names.
   */
  const candidates = [
    p.shapeName,
    p.shapeName_1,
    p.NAME_1,
    p.NAME1,
    p.name_1,
    p.NAME,
    p.name,
    p.adm1_name,
    p.ADM1_NAME,
    p.province,
    p.PROVINCE,
    p.region,
    p.REGION,
    p.state,
    p.STATE,
    p.State,
    p.admin1Name,
    p.ADMIN1
  ];

  for (const value of candidates) {

    if (
      value !== undefined &&
      value !== null &&
      String(value).trim() !== ""
    ) {

      return String(value).trim();
    }
  }

  return "Administrative Division";
}


/* =========================================================
   NAVIGATION
========================================================= */

backButton.addEventListener(
  "click",
  function() {

    hideTooltip();
    hideError();

    if (currentLevel === "state") {

      loadIndiaMap();

      return;
    }

    if (currentLevel === "world") {

      loadIndiaMap();

      return;
    }

    if (currentLevel === "country") {

      loadWorldMap();

      return;
    }
  }
);


worldButton.addEventListener(
  "click",
  function() {

    hideTooltip();

    loadWorldMap();

  }
);


retryButton.addEventListener(
  "click",
  function() {

    hideError();

    if (currentLevel === "india") {

      loadIndiaMap();

    }

    else if (currentLevel === "state") {

      loadStateMap(
        currentState
      );

    }

    else if (currentLevel === "world") {

      loadWorldMap();

    }

    else if (currentLevel === "country") {

      loadCountryMap(
        currentCountry
      );

    }

  }
);


/* =========================================================
   RESPONSIVE REDRAW
========================================================= */

let resizeTimer = null;

window.addEventListener(
  "resize",
  function() {

    clearTimeout(resizeTimer);

    resizeTimer =
      setTimeout(
        function() {

          if (
            typeof lastRender === "function"
          ) {

            try {
              lastRender();
            } catch (error) {
              console.error(error);
            }
          }

        },
        180
      );
  }
);


/* =========================================================
   START APPLICATION
========================================================= */

updateHeader();

loadIndiaMap();

</script>

